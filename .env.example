# Copy to .env and adjust. The dev servers read it; so does `docker compose` (production).

# Development database: the local Postgres (not Docker)
DATABASE_URL=postgres://band_tools:change-me@localhost:5432/band-tools

# PWA dev server (Vite)
PWA_PORT=47391

# API server (Elysia)
API_PORT=47392

# Production stack (compose.yml): the one port the app is served on
APP_PORT=41837
# Where browsers reach the app on that port; Keycloak is under its /auth path.
# APP_URL=http://localhost:41837
# Keycloak's secrets. Like Postgres's below, these go into its volume when it's
# first created; changing them later doesn't update it.
# KEYCLOAK_CLIENT_SECRET=change-me
# KEYCLOAK_ADMIN_PASSWORD=change-me
# KEYCLOAK_DB_PASSWORD=keycloak

# The API offers a Keycloak login only when KEYCLOAK_ISSUER is set; compose sets
# these for the app from the values above.
# KEYCLOAK_ISSUER=http://localhost:41837/auth/realms/band-tools
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth/realms/band-tools
# KEYCLOAK_CLIENT_ID=band-tools
# Production database (compose.yml). Postgres reads these only when its volume
# is first created, and they go into the app's DATABASE_URL unescaped: keep
# them URL-safe.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=band-tools
