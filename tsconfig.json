{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["bun"],
    "paths": { "@root/*": ["./*"] }
  },
  "include": [
    "apps/*/src",
    "apps/*/scripts",
    "apps/*/*.config.ts",
    "packages/*/src",
    "packages/*/*.config.ts",
    "scripts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
